{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bahasabahasa-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-10",

  "routes": [
    {
      "pattern": "api.bahasabahasa.com",
      "custom_domain": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bahasabahasa-db",
      "database_id": "87d3ca13-75db-4d63-956f-f2f2c4c8ffc8"
    }
  ]
}
